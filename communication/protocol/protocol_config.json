      {"field": "protocol_version", "type": "u8", "offset": 0},
      {"field": "packet_type", "type": "u8", "offset": 1},
      {"field": "seq", "type": "u16", "offset": 2},
      {"field": "first_sample_index", "type": "u32", "offset": 4},
      {"field": "sample_count", "type": "u8", "offset": 8},
